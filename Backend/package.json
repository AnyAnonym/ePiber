{
  "name": "epiber-backend",
  "version": "5.0.0-paj-1-5",
  "description": "ePiber Tennis Dashboard — Backend (WebSocket + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:worker": "node worker.js",
    "check": "node scripts/check.js",
    "check:runtime-version": "node scripts/check-runtime-version.js",
    "db:bootstrap": "node scripts/db-bootstrap.js",
    "db:import": "node scripts/db-import.js",
    "db:analyze-source": "node scripts/db-analyze-source.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:ops-smoke": "node scripts/db-ops-smoke.js",
    "db:personal-access": "node scripts/db-personal-access.js",
    "db:paj-password-rotate": "node scripts/db-paj-password-rotate.js",
    "db:paj-refresh": "node scripts/db-paj-refresh.js",
    "db:paj-refresh-swap": "node scripts/db-paj-refresh-swap.js",
    "db:schema": "node scripts/db-schema-snapshot.js",
    "db:shadow-read": "node scripts/db-shadow-read.js",
    "db:source-package": "node scripts/db-source-package.js",
    "db:seed": "node scripts/db-seed.js",
    "test": "node --test test/*.test.js",
    "test:browser": "npm run test:browser:smoke && npm run test:browser:chromium",
    "test:browser:smoke": "bash scripts/run-browser-smoke-container.sh",
    "test:browser:smoke:core": "bash scripts/run-browser-smoke-container.sh --suite core",
    "test:browser:smoke:lifecycle": "bash scripts/run-browser-smoke-container.sh --suite lifecycle",
    "test:browser:smoke:host": "node scripts/run-browser-smoke.js",
    "test:browser:chromium": "node --test test/*.browser.js",
    "test:workflow": "node --test ../scripts/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "build": "npm run check && npm test && npm run test:workflow",
    "verify": "node ../scripts/verification-workflow.mjs verify --suite auto",
    "verify:status": "node ../scripts/verification-workflow.mjs status"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "pg": "8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
