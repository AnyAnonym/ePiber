# ══════════════════════════════════════════════════════

# PostgreSQL ist der einzige unterstuetzte Laufzeitmodus.
PERSISTENCE_MODE=postgres

# PostgreSQL-Laufzeit
# PGHOST=/run/postgresql/devel
# PGPORT=5433
# PGDATABASE=epiber_devel
# PGUSER=epiber_devel_app_login
# EPIBER_DB_ROLE=epiber_devel_app
# EPIBER_DB_PASSWORD_FILE=/run/credentials/epiber-devel.service/postgres-password
# EPIBER_TENANT_CODE=devel-epiber
# Separates zufaelliges Base64url-Geheimnis mit mindestens 32 Byte Entropie.
# EPIBER_AUTH_RATE_LIMIT_SECRET=CHANGE_ME_BASE64URL
# Backend-Umgebungskonfiguration
# Diese geheimnisfreie Vorlage wird versioniert.
# Kopiere sie als .env und ersetze alle CHANGE_ME-Werte.
# ══════════════════════════════════════════════════════

# Node.js-Server-Port (pro System unterschiedlich)
# Live (piber): 8080
# PAJ:          8083
# PK:           8084
PORT=CHANGE_ME

# Instanz, Origin, Loopback-Bindung und Datenbank-Credentials setzt die jeweilige
# systemd-Unit verbindlich.
# Unsicherer Transport bleibt ohne ausdrueckliche Unit-Ausnahme deaktiviert.

# Inaktivitaetslaufzeit der Session in Sekunden (30 Tage)
SESSION_TTL_SECONDS=2592000
# Maximale parallele Sitzungen pro Benutzerkonto
SESSION_MAX_PER_USER=10

# Court-Scores-URL (normalerweise fuer alle Systeme gleich)
COURT_URL=https://scorer-tennis.b-cdn.net/json/24.voll.json

# Kommunikationsgrenzen und Timeouts (optionale sichere Defaults)
LOG_LEVEL=info
# Kommagetrennte Auditaktionen oder * fuer alle konfigurierten Mutationen
AUDIT_ACTIONS=*
HTTP_BODY_LIMIT_BYTES=8192
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_INFLIGHT=8
WS_MAX_SUBSCRIPTIONS=32
WS_REQUEST_RATE=20
WS_REQUEST_BURST=40
WS_HANDSHAKE_TIMEOUT_MS=10000
COURT_FETCH_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=90000
