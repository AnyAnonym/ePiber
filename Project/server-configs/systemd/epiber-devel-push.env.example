# Optionale geheimnisfreie Vorlage fuer /etc/epiber-devel/push.env.
# Nur zusammen mit den beiden PAJ-Push-Drop-ins und Schema 9 aktivieren.
# Nur den OEFFENTLICHEN Teil des neu erzeugten VAPID-Paars hier einsetzen.
# Der private Teil gehoert ausschliesslich in die LoadCredential-Quelldatei.
PUSH_PILOT_ENABLED=true
PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_PUBLIC_VAPID_KEY
PUSH_VAPID_SUBJECT=https://epiber.at
