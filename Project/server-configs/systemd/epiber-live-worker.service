[Unit]
Description=ePiber PostgreSQL live worker
After=postgresql-devel.service epiber-live.service
Requires=postgresql-devel.service
Conflicts=epiber-live-readonly.service
RequiresMountsFor=/var/lib/development-data

[Service]
Type=simple
User=piber
SupplementaryGroups=postgres-devel-client
WorkingDirectory=/srv/http/ePiber/piber/Backend
SyslogIdentifier=epiber-live-worker
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
LoadCredential=database:/etc/epiber-live/credentials/postgres-worker-password
ExecStart=/usr/bin/env NODE_ENV=production TZ=UTC INSTANCE_ID=live-worker PUBLIC_ORIGIN=https://epiber.at EPIBER_TENANT_CODE=askoe-piberbach PGHOST=/run/postgresql/devel PGPORT=5433 PGDATABASE=epiber_askoe PGUSER=epiber_live_worker EPIBER_DB_PASSWORD_FILE=%d/database /usr/bin/node worker.js
Restart=always
RestartSec=5
TimeoutStopSec=95
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
