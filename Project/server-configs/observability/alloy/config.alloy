logging {
	level = "info"
}

loki.relabel "epiber_journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "devel" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-devel.service"
	max_age       = "24h"
	labels        = {
		deployment = "devel",
		service    = "epiber-backend",
	}
}

loki.source.journal "live" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-piber.service"
	max_age       = "24h"
	labels        = {
		deployment = "live",
		service    = "epiber-backend",
	}
}

loki.source.journal "live_postgres" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-live.service"
	max_age       = "24h"
	labels        = {
		deployment = "live",
		service    = "epiber-backend",
	}
}

loki.source.journal "live_worker" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-live-worker.service"
	max_age       = "24h"
	labels        = {
		deployment = "live",
		service    = "epiber-worker",
	}
}

loki.source.journal "live_readonly" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-live-readonly.service"
	max_age       = "24h"
	labels        = {
		deployment = "live",
		service    = "epiber-backend",
	}
}

loki.source.journal "grafana_auth" {
	forward_to    = [loki.process.epiber.receiver]
	relabel_rules = loki.relabel.epiber_journal.rules
	matches       = "_SYSTEMD_UNIT=epiber-grafana-auth.service"
	max_age       = "24h"
	labels        = {
		deployment = "shared",
		service    = "grafana-auth",
	}
}

local.file_match "epiber_caddy" {
	path_targets = [
		{
			__path__   = "/var/log/caddy/epiber-live-access.json",
			deployment = "live",
			service    = "caddy-access",
		},
		{
			__path__   = "/var/log/caddy/epiber-devel-access.json",
			deployment = "devel",
			service    = "caddy-access",
		},
	]
}

loki.source.file "epiber_caddy" {
	targets    = local.file_match.epiber_caddy.targets
	forward_to = [loki.process.epiber_caddy.receiver]
}

loki.process "epiber" {
	forward_to = [loki.write.local.receiver]

	stage.json {
		expressions = {
			event           = "event",
			app_level       = "level",
			page_type       = "pageType",
			app_version     = "version",
			version_match   = "clientVersionMatch",
			diagnostic      = "diagnosticProfile",
			retention_class = "retentionClass",
			frontend_event  = "frontendEvent",
			frontend_level  = "frontendLevel",
		}
	}

	stage.labels {
		values = {
			event           = "",
			app_level       = "",
			page_type       = "",
			app_version     = "",
			version_match   = "",
			diagnostic      = "",
			retention_class = "",
			frontend_event  = "",
			frontend_level  = "",
		}
	}
}

loki.process "epiber_caddy" {
	forward_to = [loki.write.local.receiver]

	stage.json {
		expressions = {
			request_route = "route",
			status        = "status",
		}
	}

	stage.labels {
		values = {
			request_route = "",
			status        = "",
		}
	}
}

loki.write "local" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}
