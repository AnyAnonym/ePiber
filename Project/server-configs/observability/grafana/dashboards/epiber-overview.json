{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    { "type": "stat", "title": "Backend Ready", "id": 1, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "epiber_ready{deployment=\"$deployment\"}", "refId": "A" }] },
    { "type": "stat", "title": "WebSocket-Verbindungen", "id": 2, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 5, "x": 4, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(epiber_ws_connections{deployment=\"$deployment\"})", "refId": "A" }] },
    { "type": "stat", "title": "PostgreSQL bereit", "id": 3, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 5, "x": 9, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "min(epiber_readiness_component_ready{deployment=\"$deployment\",component=~\"postgres_runtime|postgres_score_state|postgres_audit|postgres_messaging\"})", "refId": "A" }] },
    { "type": "stat", "title": "Letzter Projektionsreload fehlgeschlagen", "id": 8, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 5, "x": 14, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "epiber_projection_refresh_failed{deployment=\"$deployment\"}", "refId": "A" }] },
    { "type": "stat", "title": "Projektionsreload aktiv", "id": 9, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 5, "x": 19, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "epiber_projection_refresh_in_progress{deployment=\"$deployment\"}", "refId": "A" }] },
    { "type": "timeseries", "title": "HTTP-Rate", "id": 4, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (result) (rate(epiber_http_requests_total{deployment=\"$deployment\"}[5m]))", "legendFormat": "{{result}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Alter des Projektionssnapshots (kein TTL)", "description": "Zeit seit dem letzten erfolgreichen PostgreSQL-Reload. Projektionen werden ereignisgesteuert erneuert; hohes Alter allein ist kein Fehler.", "id": 5, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "epiber_projection_last_success_age_seconds{deployment=\"$deployment\"}", "legendFormat": "Snapshot", "refId": "A" }] },
    { "type": "timeseries", "title": "Freier Speicher", "id": 6, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs\"}", "legendFormat": "{{mountpoint}}", "refId": "A" }] },
    { "type": "timeseries", "title": "HTTP-Latenz p95", "id": 7, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, route) (rate(epiber_http_request_duration_seconds_bucket{deployment=\"$deployment\"}[5m])))", "legendFormat": "{{route}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Projektionsreloads pro 5 Minuten", "id": 10, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (reason, result) (increase(epiber_projection_refresh_operations_total{deployment=\"$deployment\"}[5m]))", "legendFormat": "{{reason}} {{result}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Projektionsreload-Latenz p95", "id": 11, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, reason) (rate(epiber_projection_refresh_duration_seconds_bucket{deployment=\"$deployment\"}[5m])))", "legendFormat": "{{reason}}", "refId": "A" }] }
  ],
  "schemaVersion": 41,
  "tags": ["epiber", "observability"],
  "templating": { "list": [{ "name": "deployment", "label": "System", "type": "custom", "query": "live,devel", "current": { "text": "Live", "value": "live" }, "options": [{ "text": "Live", "value": "live", "selected": true }, { "text": "Devel", "value": "devel", "selected": false }] }] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "ePiber Uebersicht",
  "uid": "epiber-overview",
  "version": 5
}
