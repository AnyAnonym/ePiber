    { "type": "stat", "title": "Prometheus erreichbar", "id": 3, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"prometheus\"}", "refId": "A" }] },
    { "type": "stat", "title": "Grafana erreichbar", "id": 4, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"grafana\"}", "refId": "A" }] },
    { "type": "timeseries", "title": "Alloy an Loki gesendete Bytes", "id": 5, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(loki_write_sent_bytes_total[5m]))", "refId": "A" }] },
    { "type": "timeseries", "title": "Alloy verworfene Logzeilen", "id": 6, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (reason) (rate(loki_process_dropped_lines_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Frontenddiagnose angenommen/verworfen", "id": 7, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (outcome) (rate(epiber_frontend_events_total{deployment=\"$deployment\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }] },
    { "type": "timeseries", "title": "Loggerfehler und Backpressure", "id": 8, "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 }, "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(epiber_log_write_failed_total{deployment=\"$deployment\"}[5m]))", "legendFormat": "write failed", "refId": "A" }, { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(epiber_log_backpressure_total{deployment=\"$deployment\"}[5m]))", "legendFormat": "backpressure", "refId": "B" }] }
