#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
  echo '{"event":"paj_refresh_completed","result":"rejected","errorCode":"ROOT_REQUIRED"}' >&2
  exit 1
fi

repo="${1:-/srv/http/ePiber/paj}"
run_id="${2:-}"
if [[ ! "${run_id}" =~ ^[A-Za-z0-9_.:-]{1,128}$ ]]; then
  echo '{"event":"paj_refresh_completed","result":"rejected","errorCode":"RUN_ID_INVALID"}' >&2
  exit 1
fi

approval="/etc/epiber-devel/paj-refresh-live-export-approved"
password_hash="/etc/epiber-devel/credentials/paj-refresh-password-hash"
if [[ ! -f "${approval}" || "$(cat "${approval}")" != "${run_id}" ]]; then
  echo '{"event":"paj_refresh_completed","result":"rejected","errorCode":"LIVE_EXPORT_APPROVAL_REQUIRED"}' >&2
  exit 1
fi
if [[ ! -f "${password_hash}" || "$(stat -c %U:%G:%a "${password_hash}")" != "root:root:400" ]]; then
  echo '{"event":"paj_refresh_completed","result":"rejected","errorCode":"REFRESH_PASSWORD_HASH_INVALID"}' >&2
  exit 1
fi

rm -f "${approval}"
echo "{\"event\":\"paj_refresh_started\",\"exportRunId\":\"${run_id}\"}"
export EPIBER_MIGRATION_SOURCE_BACKEND=/srv/http/ePiber/piber/Backend
export EPIBER_MIGRATION_SOURCE_ENV=/srv/http/ePiber/piber/Backend/.env
export EPIBER_MIGRATION_SOURCE_CREDENTIAL=/srv/http/ePiber/piber/Backend/epiberpiber-31aebe556ced.json
export EPIBER_MIGRATION_SOURCE_STATE_ROOT=/var/lib/epiber-piber
export EPIBER_MIGRATION_SOURCE_SERVICE=epiber-piber.service
export EPIBER_MIGRATION_EXPORT_PROFILE=paj-refresh-v1
export EPIBER_MIGRATION_REFRESH_PASSWORD_HASH_FILE="${password_hash}"
candidate_suffix="$(printf '%s' "${run_id}" | sha256sum | cut -c1-16)"
export EPIBER_MIGRATION_IMPORT_SCRIPT="${repo}/Backend/scripts/db-paj-refresh.js"
export EPIBER_MIGRATION_CANDIDATE_DATABASE="epiber_devel_refresh_${candidate_suffix}"
export EPIBER_MIGRATION_ACTIVATE_CANDIDATE=true
exec /usr/local/sbin/epiber-migration-staging-run "${repo}" "${run_id}"
