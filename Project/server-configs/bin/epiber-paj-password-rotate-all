#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
  echo '{"event":"paj_password_rotation_completed","result":"rejected","errorCode":"ROOT_REQUIRED"}' >&2
  exit 1
fi

backend=/srv/http/ePiber/paj/Backend
target=/etc/epiber-devel/credentials/paj-refresh-password-hash
umask 0077
read -r -s -p 'Neues gemeinsames starkes PAJ-Testpasswort: ' password
echo
read -r -s -p 'Testpasswort wiederholen: ' confirmation
echo
if [[ "${password}" != "${confirmation}" ]]; then
  unset password confirmation
  echo '{"event":"paj_password_rotation_completed","result":"rejected","errorCode":"PASSWORD_CONFIRMATION_MISMATCH"}' >&2
  exit 1
fi
if (( ${#password} < 10 )) || [[ ! "${password}" =~ [[:lower:]] ]] || [[ ! "${password}" =~ [[:upper:]] ]] || [[ ! "${password}" =~ [[:digit:]] ]] || [[ ! "${password}" =~ [^[:alnum:]] ]]; then
  unset password confirmation
  echo '{"event":"paj_password_rotation_completed","result":"rejected","errorCode":"PASSWORD_STRENGTH_INVALID"}' >&2
  exit 1
fi
read -r -p 'Alle PAJ-Passwoerter ersetzen und alle Sitzungen widerrufen? ROTIEREN eingeben: ' approval
if [[ "${approval}" != "ROTIEREN" ]]; then
  unset password confirmation approval
  echo '{"event":"paj_password_rotation_completed","result":"rejected","errorCode":"ROTATION_CONFIRMATION_REQUIRED"}' >&2
  exit 1
fi
temporary="$(mktemp /run/paj-password-rotation.XXXXXX)"
trap 'rm -f -- "${temporary}"' EXIT INT TERM HUP
printf '%s' "${password}" | sha256sum | awk '{print $1}' > "${temporary}"
unset password confirmation approval
if ! runuser -u postgres-devel -- env \
  PGHOST=/run/postgresql/devel PGPORT=5433 PGDATABASE=epiber_devel PGUSER=postgres \
  EPIBER_DB_ROLE=epiber_devel_refresh \
  node "${backend}/scripts/db-paj-password-rotate.js" < "${temporary}"; then
  exit 1
fi
install -d -m 0700 -o root -g root /etc/epiber-devel/credentials
if ! install -m 0400 -o root -g root "${temporary}" "${target}"; then
  echo '{"event":"paj_password_rotation_credential_synced","result":"unknown","errorCode":"CREDENTIAL_FILE_SYNC_FAILED"}' >&2
  exit 1
fi
echo '{"event":"paj_password_rotation_credential_synced","result":"success"}'
