#!/usr/bin/env bash

set -Eeuo pipefail

readonly MAPPER="development-data"
readonly MOUNT_POINT="/var/lib/development-data"
readonly POSTGRES_SERVICE="postgresql-devel.service"
readonly GITEA_SERVICE="gitea-devel.service"

if (( EUID != 0 )); then
  echo "ERROR: Dieser Befehl muss als root ausgefuehrt werden." >&2
  exit 1
fi

systemctl stop "$GITEA_SERVICE"
systemctl stop "$POSTGRES_SERVICE"

if systemctl is-active --quiet "$GITEA_SERVICE" || systemctl is-active --quiet "$POSTGRES_SERVICE"; then
  echo "ERROR: Mindestens ein Development-Dienst ist noch aktiv." >&2
  exit 1
fi

if mountpoint -q "$MOUNT_POINT"; then
  sync
  if ! umount "$MOUNT_POINT"; then
    echo "ERROR: $MOUNT_POINT ist noch belegt; LUKS bleibt geoeffnet." >&2
    exit 1
  fi
fi

if cryptsetup status "$MAPPER" >/dev/null 2>&1; then
  cryptsetup close "$MAPPER"
fi

echo "OK: Gitea, PostgreSQL und Development-Volume sind kontrolliert gestoppt."
