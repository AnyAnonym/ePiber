#!/usr/bin/env bash

set -Eeuo pipefail

readonly DEVICE="/dev/disk/by-id/scsi-0HC_Volume_106975159"
readonly MAPPER="development-data"
readonly MOUNT_POINT="/var/lib/development-data"
readonly POSTGRES_SERVICE="postgresql-devel.service"
readonly GITEA_SERVICE="gitea-devel.service"
readonly M365_SERVICE="m365-connector.service"
readonly LEGACY_SERVICE="epiber-paj.service"
readonly APP_SERVICE="epiber-devel.service"
readonly WORKER_SERVICE="epiber-devel-worker.service"

if (( EUID != 0 )); then
  echo "ERROR: Dieser Befehl muss als root ausgefuehrt werden." >&2
  exit 1
fi

echo '{"event":"development_services_start_started","result":"started"}'

if [[ ! -b "$DEVICE" ]]; then
  echo "ERROR: Development-Volume fehlt: $DEVICE" >&2
  exit 1
fi

if ! cryptsetup status "$MAPPER" >/dev/null 2>&1; then
  cryptsetup open "$DEVICE" "$MAPPER"
fi

readonly expected_device="$(readlink -f "$DEVICE")"
readonly mapped_device="$(cryptsetup status "$MAPPER" | awk '$1 == "device:" { print $2 }')"
if [[ -z "$mapped_device" || "$(readlink -f "$mapped_device")" != "$expected_device" ]]; then
  echo "ERROR: LUKS-Mapping $MAPPER zeigt nicht auf $DEVICE." >&2
  exit 1
fi

if ! mountpoint -q "$MOUNT_POINT"; then
  mount "$MOUNT_POINT"
fi

if [[ "$(findmnt -n -o SOURCE --target "$MOUNT_POINT")" != "/dev/mapper/$MAPPER" ]]; then
  echo "ERROR: Unerwartete Mountquelle fuer $MOUNT_POINT." >&2
  exit 1
fi

if [[ "$(findmnt -n -o FSTYPE --target "$MOUNT_POINT")" != "ext4" ]]; then
  echo "ERROR: $MOUNT_POINT verwendet nicht ext4." >&2
  exit 1
fi

readonly mount_options=",$(findmnt -n -o OPTIONS --target "$MOUNT_POINT"),"
for option in noatime nodev nosuid noexec; do
  if [[ "$mount_options" != *",$option,"* ]]; then
    echo "ERROR: Mountoption $option fehlt fuer $MOUNT_POINT." >&2
    exit 1
  fi
done

systemctl start "$POSTGRES_SERVICE"
for _ in {1..30}; do
  if runuser -u postgres-devel -- /usr/bin/pg_isready -q -h /run/postgresql/devel -p 5433 -d postgres; then
    break
  fi
  sleep 1
done

if ! runuser -u postgres-devel -- /usr/bin/pg_isready -q -h /run/postgresql/devel -p 5433 -d postgres; then
  echo "ERROR: PostgreSQL wurde nicht rechtzeitig bereit." >&2
  exit 1
fi

systemctl start "$GITEA_SERVICE"
for _ in {1..30}; do
  if curl --fail --silent --output /dev/null http://127.0.0.1:3002/; then
    break
  fi
  sleep 1
done

if ! curl --fail --silent --show-error --output /dev/null http://127.0.0.1:3002/; then
  echo "ERROR: Gitea wurde nicht rechtzeitig bereit." >&2
  exit 1
fi

systemctl start "$M365_SERVICE"
for _ in {1..30}; do
  if curl --fail --silent --header 'Host: m365-connector.pi-tec.at' --output /dev/null http://127.0.0.1:3000/health/ready; then
    break
  fi
  sleep 1
done

if ! curl --fail --silent --show-error --header 'Host: m365-connector.pi-tec.at' --output /dev/null http://127.0.0.1:3000/health/ready; then
  echo '{"event":"development_services_start_completed","result":"failed","errorCode":"M365_CONNECTOR_NOT_READY"}' >&2
  exit 1
fi

# Alte Installationen weiter absichern, neue ohne entfernte Legacy-Unit zulassen.
# Keine readonly-Zuweisung: Fehler der systemctl-Abfrage muessen fatal bleiben.
legacy_load_state="$(systemctl show "$LEGACY_SERVICE" --property=LoadState --value)"
if [[ "$legacy_load_state" != "not-found" ]]; then
  systemctl stop "$LEGACY_SERVICE"
fi
systemctl start "$APP_SERVICE"
for _ in {1..30}; do
  if curl --fail --silent --output /dev/null http://127.0.0.1:8083/ready; then
    break
  fi
  sleep 1
done

if ! curl --fail --silent --show-error --output /dev/null http://127.0.0.1:8083/ready; then
  systemctl stop "$APP_SERVICE"
  echo '{"event":"development_services_start_completed","result":"failed","errorCode":"EPIBER_DEVEL_NOT_READY"}' >&2
  exit 1
fi

systemctl start "$WORKER_SERVICE"

systemctl is-active --quiet "$POSTGRES_SERVICE"
systemctl is-active --quiet "$GITEA_SERVICE"
systemctl is-active --quiet "$M365_SERVICE"
systemctl is-active --quiet "$APP_SERVICE"
systemctl is-active --quiet "$WORKER_SERVICE"
systemctl is-active --quiet "$LEGACY_SERVICE" && {
  echo '{"event":"development_services_start_completed","result":"failed","errorCode":"LEGACY_SERVICE_ACTIVE"}' >&2
  exit 1
}
echo '{"event":"development_services_start_completed","result":"success","postgres":"active","gitea":"active","m365Connector":"active","app":"active","worker":"active","legacy":"inactive"}'
echo "OK: Development-Volume, PostgreSQL, Gitea, M365-Konnektor, ePiber-App und Worker sind bereit."
