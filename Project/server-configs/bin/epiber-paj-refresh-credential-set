#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
  echo '{"event":"paj_refresh_credential_completed","result":"rejected","errorCode":"ROOT_REQUIRED"}' >&2
  exit 1
fi

target=/etc/epiber-devel/credentials/paj-refresh-password-hash
umask 0077
read -r -s -p 'Gemeinsames starkes PAJ-Testpasswort: ' password
echo
read -r -s -p 'Testpasswort wiederholen: ' confirmation
echo
if [[ "${password}" != "${confirmation}" ]]; then
  unset password confirmation
  echo '{"event":"paj_refresh_credential_completed","result":"rejected","errorCode":"PASSWORD_CONFIRMATION_MISMATCH"}' >&2
  exit 1
fi
if (( ${#password} < 10 )) || [[ ! "${password}" =~ [[:lower:]] ]] || [[ ! "${password}" =~ [[:upper:]] ]] || [[ ! "${password}" =~ [[:digit:]] ]] || [[ ! "${password}" =~ [^[:alnum:]] ]]; then
  unset password confirmation
  echo '{"event":"paj_refresh_credential_completed","result":"rejected","errorCode":"PASSWORD_STRENGTH_INVALID"}' >&2
  exit 1
fi
temporary="$(mktemp /run/paj-refresh-password-hash.XXXXXX)"
trap 'rm -f -- "${temporary}"' EXIT INT TERM HUP
printf '%s' "${password}" | sha256sum | awk '{print $1}' > "${temporary}"
unset password confirmation
install -d -m 0700 -o root -g root /etc/epiber-devel/credentials
install -m 0400 -o root -g root "${temporary}" "${target}"
echo '{"event":"paj_refresh_credential_completed","result":"success"}'
